# Names and examples only. Never commit the real .env or .local state.
# Generate independent random secrets and new volume names for each local checkout.
# AWS uses its existing values and separately approved migration plan.
COMPOSE_PROJECT_NAME=quickflow-local
QF_IMAGE=quickflow:local
QF_SOURCE_REVISION=REPLACE_WITH_GIT_COMMIT
QF_DB_PASSWORD=REPLACE_WITH_NEW_RANDOM_HEX
QF_SECRET_KEY_BASE=REPLACE_WITH_NEW_128_HEX
QF_APP_ENV_FILE=.local/app.env
QF_SITE_ADDRESS=https://localhost
QF_BIND_ADDRESS=127.0.0.1
QF_HTTP_PORT=18080
QF_HTTPS_PORT=18443
QF_DB_VOLUME=quickflow-local-db
QF_STORAGE_VOLUME=quickflow-local-storage
QF_CADDY_DATA_VOLUME=quickflow-local-caddy-data
QF_CADDY_CONFIG_VOLUME=quickflow-local-caddy-config
# Optional: pin a separately verified PostgreSQL/Caddy image for an AWS migration.
# QF_POSTGRES_IMAGE=postgres:18.6@sha256:...
# QF_CADDY_IMAGE=caddy:2@sha256:...
# .local/app.env is app-only. Local verification leaves it empty.
# Existing AWS credentials stay on AWS; never copy its master key/API key here.
