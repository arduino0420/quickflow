#!/usr/bin/env python3
"""Local-only Docker workflow. Never deploys, deletes volumes, or resets databases."""
import hashlib, json, os, pathlib, secrets, subprocess, sys, time, ssl, urllib.request, stat
ROOT = pathlib.Path(__file__).resolve().parents[1]
MODES = ('dev', 'check', 'test')
ACTIONS = ('build', 'init', 'up', 'stop', 'status', 'verify', 'smoke', 'test', 'test-core')
class NoReadinessRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        fail('Readiness endpoint redirected; refusing to follow')

def fail(message): raise RuntimeError(message)
def digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()
def source_hash():
    h = hashlib.sha256()
    paths = [ROOT / n for n in ('.ruby-version', 'Gemfile', 'Gemfile.lock', 'Dockerfile', 'Dockerfile.dev', 'Dockerfile.test')]
    for folder in ('app','lib','config','bin','db','public','spec'):
        paths += [p for p in (ROOT/folder).rglob('*') if p.is_file() and not p.is_symlink()]
    for p in sorted(set(paths)):
        rel = p.relative_to(ROOT).as_posix()
        if '__pycache__' in p.parts or rel == 'bin/local' or p.suffix in ('.key','.pem') or '/master.key' in rel: continue
        h.update(rel.encode()+b'\0'+p.read_bytes()+b'\0')
    return h.hexdigest()
def schema_hash():
    h=hashlib.sha256()
    for p in sorted((ROOT/'db').rglob('*.rb')): h.update(p.relative_to(ROOT).as_posix().encode()+p.read_bytes())
    return h.hexdigest()
def run(args, *, capture=False, log=None, check=True):
    if log:
        with open(log,'w') as f: p=subprocess.run(args,env=ENV,cwd=ROOT,stdout=f,stderr=subprocess.STDOUT)
    else: p=subprocess.run(args,env=ENV,cwd=ROOT,text=True,stdout=subprocess.PIPE if capture else None)
    if check and p.returncode: fail('Command failed: '+args[0]+'; '+('see '+str(log) if log else 'review output'))
    return p.stdout.strip() if capture else p.returncode

def compose(*args, **kw): return run(DOCKER+['compose','--project-name',PROJECT,'--env-file',str(ENVFILE),'-f',str(FILE),*args],**kw)
def inspect(kind,name): return json.loads(run(DOCKER+[kind,'inspect',name],capture=True))[0]
def dbname(): return {'dev':'quickflow_development','check':'quickflow_production','test':'quickflow_test'}[MODE]
def service(): return 'test' if MODE=='test' else 'web'
def image_ref(): return ENV['QF_'+({'dev':'DEV','check':'CHECK','test':'TEST'}[MODE])+'_IMAGE']
def dependency_hash():
    h=hashlib.sha256()
    for name in ('.ruby-version','Gemfile','Gemfile.lock','Dockerfile.dev'):
        h.update(name.encode()+b'\0'+(ROOT/name).read_bytes())
    return h.hexdigest()
def image_guard(ref=None, role=None):
    role=role or MODE
    image=inspect('image',ref or image_ref()); labels=image['Config'].get('Labels') or {}
    if labels.get('io.quickflow.local.mode') != role: fail('Image mode mismatch')
    if labels.get('io.quickflow.local.lock') != ENV['QF_LOCK_SHA']: fail('Gemfile.lock changed or image unverified: rebuild this mode')
    if role=='dev' and labels.get('io.quickflow.local.dependencies') != ENV['QF_DEPS_SHA']: fail('Development dependencies changed: rebuild')
    if role != 'dev' and labels.get('io.quickflow.local.source') != ENV['QF_SOURCE_SHA']: fail('Application or test source changed: rebuild before checking')
    actual=run(DOCKER+['run','--rm','--network','none','--entrypoint','ruby',image['Id'],'-rdigest','-e','abort "image Ruby mismatch" unless RUBY_VERSION == File.read("/rails/.ruby-version").strip; puts RUBY_VERSION; puts Digest::SHA256.file("/rails/Gemfile.lock").hexdigest; puts Digest::SHA256.file("/rails/Gemfile").hexdigest'],capture=True).splitlines()
    if actual != [(ROOT/'.ruby-version').read_text().strip(),ENV['QF_LOCK_SHA'],digest(ROOT/'Gemfile')]: fail('Actual image Ruby/Gemfile/lock differs from source')
    return image['Id']
def configuration_guard():
    cfg=json.loads(compose('config','--format','json',capture=True))
    for name,s in cfg['services'].items():
        for port in s.get('ports',[]):
            if port.get('host_ip')!='127.0.0.1': fail('Only loopback published ports allowed')
        for m in s.get('volumes',[]):
            if m['type']=='bind':
                p=pathlib.Path(m['source']).resolve()
                if not p.is_relative_to(ROOT) or p in (ROOT,ROOT/'config') or not m.get('read_only'): fail('Unsafe bind mount')
                if p.suffix in ('.key','.pem') or p.name.startswith('.env'): fail('Secret bind forbidden')
        env=s.get('environment') or {}
        if any(k in env for k in ('RAILS_MASTER_KEY','OPENAI_API_KEY','AWS_ACCESS_KEY_ID','AWS_SECRET_ACCESS_KEY')): fail('Real credentials forbidden')
        networks=set(s.get('networks',{}))
        if name!='caddy' and networks!={'isolated'}: fail('App/DB/test must use internal network only')
    if MODE=='dev':
        mounted={v.get('target') for v in cfg['services']['web'].get('volumes',[]) if v['type']=='bind'}
        required={'/rails/'+p.relative_to(ROOT).as_posix() for p in (ROOT/'config/initializers').glob('*.rb')}
        if not required <= mounted: fail('New initializer is not in the safe bind allowlist: update Compose deliberately')
    if cfg['networks']['isolated'].get('internal') is not True: fail('Internal network required')
    return cfg

def runtime_guard(required=()):
    ids=run(DOCKER+['ps','-aq','--filter','label=com.docker.compose.project='+PROJECT],capture=True).split()
    running=set(); expected_cfg=configuration_guard()
    for id in ids:
        c=inspect('container',id); labels=c['Config'].get('Labels') or {}
        if labels.get('com.docker.compose.project')!=PROJECT: fail('Wrong project')
        role=labels.get('com.docker.compose.service')
        if c['State']['Running']:
            running.add(role)
            if role not in expected_cfg['services'] or c['Image']!=inspect('image',expected_cfg['services'][role]['image'])['Id']: fail('Running service image differs from expected image')
        actual_env=dict(x.split('=',1) for x in c['Config']['Env'] if '=' in x)
        if any(k in actual_env for k in ('RAILS_MASTER_KEY','OPENAI_API_KEY','AWS_ACCESS_KEY_ID','AWS_SECRET_ACCESS_KEY')): fail('Runtime real credential variable forbidden')
        for n in c['NetworkSettings'].get('Networks',{}):
            if n!=PROJECT+'_isolated' and not (n==PROJECT+'_ingress' and labels.get('com.docker.compose.service')=='caddy'): fail('Foreign network')
            internal=inspect('network',n)['Internal']
            if not internal and labels.get('com.docker.compose.service')!='caddy': fail('Runtime egress network unexpected')
        for ports in (c['HostConfig'].get('PortBindings') or {}).values():
            for port in ports or []:
                if port['HostIp']!='127.0.0.1': fail('Non-loopback runtime port')
        for m in c['Mounts']:
            if m['Type']=='volume' and not m['Name'].startswith(PROJECT+'_'): fail('Foreign volume')
            if m['Type']=='bind':
                p=pathlib.Path(m['Source'].removeprefix('/host_mnt')).resolve()
                if not p.is_relative_to(ROOT) or m['RW']: fail('Unsafe runtime bind')
    if not set(required)<=running: fail('Required services not running: '+','.join(sorted(set(required)-running)))
    report={'mode':MODE,'project':PROJECT,'containers':len(ids),'running_services':sorted(running),'network_configuration_observed':bool(ids),'required_services_verified':bool(required)}
    (EVIDENCE/'isolation.json').write_text(json.dumps(report,indent=2)); return report

def marker_guard():
    if not MARKER.exists(): fail('Run init for this new dedicated environment first')
    m=json.loads(MARKER.read_text())
    if m['project']!=PROJECT or m['root']!=str(ROOT) or m['env_sha']!=digest(ENVFILE): fail('Environment identity changed')
    if m['schema_sha']!=schema_hash(): fail('DB definition changed: explicit migration review required; no automatic migration')
    if m['daemon_id']!=run(DOCKER+['info','--format','{{.ID}}'],capture=True): fail('Docker daemon identity changed')
    volume=inspect('volume',m['volume'])
    if volume.get('CreatedAt')!=m['volume_created']: fail('Volume identity changed')
    return m

def main():
    configuration_guard()
    if ACTION=='build':
        if MODE=='test':
            base=image_guard(ENV['QF_CHECK_IMAGE'],'check')
            pinned='quickflow-local-check-base:'+base.split(':',1)[1]
            run(DOCKER+['tag',base,pinned]); ENV['QF_CHECK_IMAGE']=pinned
            if inspect('image',pinned)['Id']!=base: fail('Pinned check image identity mismatch')
        compose('build',service()); image=image_guard()
        # Assert that secret keys and local-only AI override are absent from images.
        run(DOCKER+['run','--rm','--network','none','--entrypoint','sh',image,'-c','test ! -f /rails/config/master.key && test ! -e /rails/config/initializers/zz_local_fake_ai.rb && test ! -e /rails/docker/local/fake_ai_initializer.rb'])
        (EVIDENCE/'build.json').write_text(json.dumps({'image':image,'source':ENV['QF_SOURCE_SHA'],'lock':ENV['QF_LOCK_SHA']},indent=2))
        print('Built',MODE,image); return
    if ACTION=='status': compose('ps','-a'); return
    if ACTION=='stop':
        runtime_guard(); compose('stop'); print('Stopped this project only; volumes retained'); return
    if ACTION=='verify':
        marker_guard(); image_guard(); print(json.dumps(runtime_guard(('db',) if MODE=='test' else ('db','web','caddy')))); return
    if ACTION=='init':
        image_guard()
        if MARKER.exists(): marker_guard(); print('Already initialized; no DB changes'); return
        pending=STATE/'initialization.pending.json'
        if pending.exists(): fail('Previous initialization needs inspection; no automatic retry/reset')
        cfg=configuration_guard(); vol=cfg['volumes']['db_data']['name']
        existing=run(DOCKER+['volume','ls','-q','--filter','name=^'+vol+'$'],capture=True)
        if existing: fail('Existing DB volume without initialization record: refusing to reuse')
        pending.write_text(json.dumps({'project':PROJECT,'volume':vol}))
        compose('up','-d','--wait','db'); runtime_guard(('db',))
        tables=compose('exec','-T','db','psql','-U','quickflow','-d',dbname(),'-Atc',"select count(*) from information_schema.tables where table_schema='public';",capture=True)
        if tables!='0': fail('Expected a fresh empty dedicated database')
        compose('run','--rm','--no-deps','--entrypoint','bin/rails',service(),'db:prepare')
        v=inspect('volume',vol)
        MARKER.write_text(json.dumps({'project':PROJECT,'root':str(ROOT),'env_sha':digest(ENVFILE),'schema_sha':schema_hash(),'volume':vol,'volume_created':v.get('CreatedAt'),'daemon_id':run(DOCKER+['info','--format','{{.ID}}'],capture=True)},indent=2))
        pending.rename(STATE/'initialization.completed.json'); print('Dedicated DB initialized:',dbname()); return
    marker_guard(); expected=image_guard()
    if ACTION=='up':
        if MODE=='test': fail('Use test test, not test up')
        compose('up','-d'); runtime_guard(('db','web','caddy'))
        url='http://localhost:18080/up' if MODE=='dev' else 'https://localhost:18444/up'
        context=ssl._create_unverified_context() if MODE=='check' else None
        opener=urllib.request.build_opener(urllib.request.ProxyHandler({}),NoReadinessRedirect(),urllib.request.HTTPSHandler(context=context))
        for _ in range(60):
            try:
                with opener.open(url,timeout=2) as response:
                    if response.status==200: print('Ready:',url); return
            except Exception: time.sleep(1)
        fail('Health check failed; inspect this project logs')
    if ACTION=='smoke':
        if MODE=='test': fail('Use test test')
        runtime_guard(('db','web','caddy'))
        cid=compose('ps','-q','web',capture=True)
        if inspect('container',cid)['Image']!=expected: fail('Running image differs from verified image')
        if MODE=='check':
            compose('exec','-T','web','bin/rails','runner','/local/smoke.rb',log=EVIDENCE/'inprocess.log')
        compose('exec','-T','web','bin/rails','runner','/local/http-fixture.rb',log=EVIDENCE/'fixture.log')
        fixture=STATE/'http-fixture.private.json'
        run(DOCKER+['cp',cid+':/rails/tmp/local-http-fixture.private.json',str(fixture)]); fixture.chmod(0o600)
        run([sys.executable,str(ROOT/'docker/local/http-smoke.py'),MODE,str(fixture)],log=EVIDENCE/'http-smoke.log')
        if inspect('container',cid)['Image']!=expected: fail('Image changed during smoke')
        (EVIDENCE/'smoke.json').write_text(json.dumps({'mode':MODE,'image':expected,'passed':True,'inprocess_checked':MODE=='check','real_http_checked':True,'real_ai':False,'browser_canvas':False},indent=2))
        print('Synthetic real HTTP smoke passed (in-process additionally checked for check mode); see',EVIDENCE); return
    if ACTION in ('test', 'test-core'):
        if MODE!='test': fail('Tests require test mode')
        runtime_guard(('db',)); name=PROJECT+'-suite-'+secrets.token_hex(4)
        artifact='rspec-core' if ACTION=='test-core' else 'rspec'
        exclusions=['--exclude-pattern','spec/system/**/*_spec.rb'] if ACTION=='test-core' else []
        code=compose('run','--no-deps','--name',name,'test','bundle','exec','rspec',*exclusions,'--format','progress','--format','json','--out','/rails/tmp/local-rspec.json',log=EVIDENCE/(artifact+'.log'),check=False)
        run(DOCKER+['cp',name+':/rails/tmp/local-rspec.json',str(EVIDENCE/(artifact+'.json'))],check=False)
        if code: fail('RSpec failed; see '+str(EVIDENCE/(artifact+'.log')))
        print('Non-system RSpec passed; browser/system specs excluded' if ACTION=='test-core' else 'All RSpec passed', '; see',EVIDENCE); return

if __name__=='__main__':
    try:
        if len(sys.argv)!=3 or sys.argv[1] not in MODES or sys.argv[2] not in ACTIONS: fail('Usage: bin/local <dev|check|test> <'+ '|'.join(ACTIONS)+'>')
        MODE,ACTION=sys.argv[1:]; token=hashlib.sha256(str(ROOT).encode()).hexdigest()[:10]
        PROJECT='qfl-'+MODE+'-'+token; STATE=ROOT/'.local'/MODE; EVIDENCE=STATE/'evidence'
        STATE.mkdir(parents=True,exist_ok=True); STATE.chmod(0o700); EVIDENCE.mkdir(exist_ok=True)
        ENV={k:os.environ[k] for k in ('HOME','PATH','USER','LOGNAME','TMPDIR','DOCKER_CONFIG') if k in os.environ}; ENV['LC_ALL']='C'
        if os.environ.get('DOCKER_HOST') and not os.environ['DOCKER_HOST'].startswith('unix://'): fail('Local workflow refuses remote DOCKER_HOST')
        context=os.environ.get('DOCKER_CONTEXT') or run(['docker','context','show'],capture=True)
        endpoint=json.loads(run(['docker','context','inspect',context],capture=True))[0]['Endpoints']['docker']['Host']
        if not endpoint.startswith('unix://'): fail('Local workflow refuses non-local Docker endpoints')
        DOCKER=['docker','--context',context]
        ENVFILE=STATE/'runtime.env'; MARKER=STATE/'initialized.json'
        if not ENVFILE.exists():
            fd=os.open(ENVFILE,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
            with os.fdopen(fd,'w') as f:f.write('QF_LOCAL_DB_PASSWORD='+secrets.token_hex(24)+'\nQF_LOCAL_SECRET_KEY_BASE='+secrets.token_hex(64)+'\n')
        if stat.S_IMODE(ENVFILE.stat().st_mode)&0o077: fail('Local secret file must remain private (0600)')
        vals=dict(line.split('=',1) for line in ENVFILE.read_text().splitlines())
        if set(vals)!={'QF_LOCAL_DB_PASSWORD','QF_LOCAL_SECRET_KEY_BASE'} or any(not v or any(c not in '0123456789abcdef' for c in v) for v in vals.values()): fail('Unexpected local environment file')
        ENV.update(vals); ENV.update(QF_LOCAL_MODE=MODE,QF_DEPS_SHA=dependency_hash(),QF_SOURCE_SHA=source_hash(),QF_LOCK_SHA=digest(ROOT/'Gemfile.lock'),QF_DEV_IMAGE='quickflow-local-dev:'+token,QF_CHECK_IMAGE='quickflow-local-check:'+token,QF_TEST_IMAGE='quickflow-local-test:'+token)
        FILE=ROOT/({'dev':'compose.yaml','check':'compose.check.yaml','test':'compose.test.yaml'}[MODE])
        main()
    except Exception as error:
        print('LOCAL WORKFLOW STOPPED:',str(error),file=sys.stderr); sys.exit(1)
