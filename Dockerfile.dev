# syntax=docker/dockerfile:1
# Local development only. Source binds are explicitly allowlisted in compose.yaml.
ARG RUBY_VERSION=4.0.6
FROM ruby:${RUBY_VERSION}-slim
WORKDIR /rails
RUN apt-get update -qq && apt-get install --no-install-recommends -y \
    build-essential git curl unzip libffi-dev libpq-dev libvips libyaml-dev \
    libjemalloc2 pkg-config postgresql-client && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists/*
ENV RAILS_ENV=development \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_FROZEN=true \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="" \
    LD_PRELOAD=/usr/local/lib/libjemalloc.so
COPY bin/install-qpdf bin/install-qpdf
RUN bin/install-qpdf
COPY vendor/* ./vendor/
COPY Gemfile Gemfile.lock ./
RUN bundle install && rm -rf /usr/local/bundle/ruby/*/cache
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash
COPY --chown=1000:1000 . .
# Keep an immutable lock reference for the host-side guard to compare.
RUN cp Gemfile.lock /image-Gemfile.lock && chown -R 1000:1000 /rails/tmp /rails/log /rails/storage
USER 1000:1000
EXPOSE 3000
ENTRYPOINT []
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]
