<h1>教師の新規登録</h1>
<%= link_to "教師一覧へ戻る", admin_teachers_path %>

<% if @teacher.errors.any? %>
  <div role="alert"><ul>
    <% @teacher.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
  </ul></div>
<% end %>

<%= form_with model: @teacher, url: admin_teachers_path, method: :post do |form| %>
  <div>
    <%= label_tag :school_code, "学校コード" %>
    <%= text_field_tag :school_code, @school.school_code, readonly: true %>
  </div>
  <div>
    <%= form.label :user_id, "教師ID" %>
    <%= form.text_field :user_id, required: true, autocomplete: "off" %>
  </div>
  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", value: nil %>
    <p>15文字以上、72バイト以下で設定してください。貼り付けも利用できます。</p>
  </div>
  <div>
    <%= form.label :password_confirmation, "パスワード（確認）" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", value: nil %>
  </div>
  <fieldset>
    <legend>担当クラス</legend>
    <p>担当クラスがない場合は、選択せずに登録できます。</p>
    <%= hidden_field_tag "teacher[classroom_codes][]", "" %>
    <% (1..3).each do |grade| %>
      <fieldset>
        <legend><%= grade %>年</legend>
        <% (1..10).each do |number| %>
          <% code = "#{grade}-#{number}" %>
          <label>
            <%= check_box_tag "teacher[classroom_codes][]", code, @selected_classroom_codes.include?(code), id: "teacher_classroom_#{grade}_#{number}" %>
            <%= grade %>年<%= number %>組
          </label>
        <% end %>
      </fieldset>
    <% end %>
  </fieldset>
  <%= form.submit "教師を登録する" %>
<% end %>
