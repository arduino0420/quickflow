<h1>生徒の新規登録</h1>
<%= link_to "管理者トップに戻る", admin_root_path %>
<% if notice.present? %><p role="status"><%= notice %></p><% end %>
<% if @student.errors.any? %>
  <div role="alert"><ul>
    <% @student.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
  </ul></div>
<% end %>
<%= form_with model: @student, url: admin_students_path, method: :post do |form| %>
  <div>
    <%= label_tag :school_code, "学校コード" %>
    <%= text_field_tag :school_code, @school.school_code, readonly: true %>
  </div>
  <div>
    <%= form.label :grade, "学年" %>
    <%= select_tag "student[grade]", options_for_select((1..3).map { |n| [ "#{n}年", n ] }, @grade), prompt: "選択してください", required: true, id: "student_grade" %>
  </div>
  <div>
    <%= form.label :class_number, "クラス" %>
    <%= select_tag "student[class_number]", options_for_select((1..10).map { |n| [ "#{n}組", n ] }, @class_number), prompt: "選択してください", required: true, id: "student_class_number" %>
  </div>
  <div>
    <%= form.label :attendance_number, "出席番号" %>
    <%= form.select :attendance_number, (1..40).map { |n| [ "#{n}番", n ] }, { prompt: "選択してください" }, required: true %>
  </div>
  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", value: nil %>
    <p>推測しにくい半角数字8桁を設定してください。</p>
  </div>
  <div>
    <%= form.label :password_confirmation, "パスワード（確認）" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", value: nil %>
  </div>
  <%= form.submit "生徒を登録する" %>
<% end %>
