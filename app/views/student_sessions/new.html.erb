<h1 class="auth-heading">生徒ログイン</h1>

<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<% if student = current_student %>
  <p>ログイン中: <%= student.classroom.grade %>年 <%= student.classroom.class_number %>組 出席番号 <%= student.attendance_number %></p>
  <%= button_to "ログアウト", student_logout_path, method: :delete %>
<% else %>
  <%= form_with scope: :student_session, url: student_login_path do |form| %>
    <div>
      <%= form.label :school_code, "学校コード" %>
      <%= form.text_field :school_code, autocomplete: "off", spellcheck: false %>
    </div>
    <div>
      <%= form.label :grade, "学年" %>
      <%= form.number_field :grade, min: 1, max: 6, step: 1, autocomplete: "off", inputmode: "numeric" %>
    </div>
    <div>
      <%= form.label :class_number, "クラス番号" %>
      <%= form.number_field :class_number, min: 1, max: 15, step: 1, autocomplete: "off", inputmode: "numeric" %>
    </div>
    <div>
      <%= form.label :attendance_number, "出席番号" %>
      <%= form.number_field :attendance_number, min: 1, max: 40, step: 1, autocomplete: "off", inputmode: "numeric" %>
    </div>
    <div>
      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>
    <%= form.submit "ログイン" %>
  <% end %>
  <details class="account-registration-help">
    <summary>アカウントの登録について</summary>
    <p>生徒アカウントは所属を確認した先生が登録します。新規登録は先生に依頼し、受け取った情報でログインしてください。</p>
  </details>
<% end %>
