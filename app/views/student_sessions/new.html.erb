<% content_for :title, "生徒ログイン | QuickFlow" %>
<h1 class="auth-heading">生徒ログイン</h1>

<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<% if student = current_student %>
  <p>ログイン中: <%= student.classroom.grade %>年 <%= student.classroom.class_number %>組 出席番号 <%= student.attendance_number %></p>
  <%= button_to "ログアウト", student_logout_path, method: :delete %>
<% else %>
  <%= form_with scope: :student_session, url: student_login_path do |form| %>
    <div>
      <%= form.label :school_code, "学校コード" %>
      <%= form.text_field :school_code, autocomplete: "off", spellcheck: false, placeholder: "例：SCHOOL01" %>
    </div>
    <div>
      <%= form.label :grade, "学年" %>
      <%= form.select :grade, (1..3).map { |n| [ "#{n}年", n ] }, prompt: "選択してください" %>
    </div>
    <div>
      <%= form.label :class_number, "クラス番号" %>
      <%= form.select :class_number, (1..10).map { |n| [ "#{n}組", n ] }, prompt: "選択してください" %>
    </div>
    <div>
      <%= form.label :attendance_number, "出席番号" %>
      <%= form.select :attendance_number, (1..40).map { |n| [ "#{n}番", n ] }, prompt: "選択してください" %>
    </div>
    <div>
      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password, autocomplete: "current-password" %>
    </div>
    <%= form.submit "ログイン" %>
  <% end %>
<% end %>
