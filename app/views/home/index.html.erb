<section class="home-intro" aria-label="QuickFlowの紹介">
  <h1 class="app-brand home-wordmark" aria-label="QuickFlow"><% if (Demo::Profile.identity? || guest_session?) %><%= link_to "QuickFlow", normal_selection_home_url, aria: { label: "QuickFlow 通常のログイン選択へ" } %><% else %>QuickFlow<% end %></h1>
</section>
<% unless (Demo::Profile.identity? || guest_session?) %>
  <nav class="home-login-options" aria-label="ログインの選択">
    <%= link_to "教師としてログインする", login_path, class: "button button-secondary" %>
    <%= link_to "生徒としてログインする", student_login_path, class: "button button-secondary" %>
    <% if (guest_url = configured_guest_entry_url) %>
      <%= link_to "ゲストとしてログインする", guest_url, class: "button button-secondary" %>
    <% else %>
      <button type="button" class="button button-secondary" disabled aria-describedby="guest-unavailable">ゲストとしてログインする</button>
    <% end %>
  </nav>
  <% unless guest_url %><p id="guest-unavailable" class="home-guest-status">ゲスト体験は準備中です。</p><% end %>
<% end %>
<% if Demo::Guest.enabled? %>
  <nav class="home-guest-options" aria-label="ゲストの役割を選択">
    <% { "admin" => "管理者", "teacher" => "教師", "student" => "生徒" }.each do |role, label| %>
      <%= button_to "#{label}ゲストで閲覧", guest_login_path(role: role), method: :post, class: "button button-secondary" %>
    <% end %>
  </nav>
<% end %>
