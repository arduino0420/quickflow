<% content_for :title, "答案詳細 | QuickFlow" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<h1>答案詳細</h1>
<% if notice.present? %><p role="status"><%= notice %></p><% end %>
<% if alert.present? %><p role="alert"><%= alert %></p><% end %>
<%= link_to "小テスト詳細へ戻る", assignment_path(@assignment, **(@return_context.presence || { classroom_id: @submission.student.classroom_id })) %>
<p><%= @assignment.title %> ／ <%= classroom_label(@submission.student.classroom) %> <%= @submission.student.attendance_number %>番</p>
<% unless @submission.completed? %><p>採点状態：<%= submission_status_label(@submission) %></p><% end %>
<% if (@submission.grading? || @submission.submitted?) && @grading_recovery_offer&.dig(:result) != "candidate" %>
  <p>この状態の答案は画面から採点を再開できません。処理が進まない場合は運用担当者に確認してください。</p>
<% end %>
<p id="pending-review-count">未確認の要確認：<%= @pending_review_count %>件</p>
<p id="submission-score">現在の得点：<%= submission_score_label(@submission, @score, pending_review_count: @pending_review_count) %></p>
<% if !@score.nil? && @pending_review_count.positive? %>
  <p>要確認が残るため暫定の得点です。要確認は加点していません。</p>
<% end %>
<% unless @submission.completed? %>
  <p class="grading-state-notice">採点結果は未完成です。要確認件数は現在保存されている結果に基づく暫定件数です。</p>
<% end %>

<div class="teacher-review-layout">
  <section aria-labelledby="answer-heading">
    <h2 id="answer-heading">答案PDF</h2>
    <% if @submission.answer_file.attached? %>
      <% if @submission.answer_file.content_type == "application/pdf" %>
        <%= render "shared/answer_pdf", url: answer_assignment_submission_path(@assignment, @submission), title: "生徒の答案PDF" %>
      <% else %>
        <p>答案ファイルをPDFとして表示できません。運用担当者に確認してください。</p>
      <% end %>
    <% else %>
      <p>答案PDFが添付されていません。</p>
    <% end %>
  </section>

  <section aria-labelledby="results-heading">
    <% retry_available = !guest_session? && grading_recovery_enabled? && @grading_recovery_offer&.dig(:result) == "candidate" %>
    <% retry_unknown = !@submission.completed? && %w[pending uncertain].include?(@submission.grading_recovery_state) %>
    <% if @submission.failed? || retry_available || retry_unknown %>
      <h2 id="results-heading"><%= retry_unknown ? "再依頼の受付状況を確認できません" : (@submission.failed? ? "採点に失敗しました" : "採点の再開") %></h2>
      <div class="grading-retry">
        <p id="retry-guidance">再依頼では答案や既存の結果を削除しません。API料金が発生する場合があり、原因によっては再び失敗することがあります。</p>
        <% if retry_available %>
          <%= button_to "採点をもう一度依頼する", resume_grading_assignment_submission_path(@assignment, @submission), method: :post,
            params: { retry_request_token: @grading_recovery_offer.fetch(:request_token) },
            class: "grading-retry-button", aria: { describedby: "retry-guidance" },
            data: { turbo_submits_with: "依頼を受け付けています…" } %>
          <p>受付は最大3回、前の受付から60秒以上あけて行えます。保存済みデータと処理状況を再確認してから開始します。</p>
        <% else %>
          <button type="button" class="grading-retry-button" disabled aria-describedby="retry-guidance retry-unavailable">採点をもう一度依頼する</button>
          <p id="retry-unavailable"><%= guest_session? ? "ゲストは採点を再依頼できません。" : grading_recovery_message %></p>
        <% end %>
      </div>
    <% else %>
    <h2 id="results-heading">問題ごとの採点結果</h2>
    <% if !@submission.completed? %>
      <p>採点が完了すると、ここに結果が表示されます。</p>
    <% elsif @grading_results.empty? %>
      <p>採点結果がありません。</p>
    <% else %>
      <% unless guest_session? %><p>正解・不正解を選択し、「保存」を押すと変更した問題だけに反映されます。</p><% end %>
      <%= form_with url: assignment_submission_path(@assignment, @submission, **@return_context), method: :patch, id: "teacher-judgments" do %>
        <% @grading_results.each do |result| %>
          <article class="grading-result teacher-grading-result judgment-<%= result.final_judgment %>" id="question_<%= result.question_id %>">
            <h3>問題 <%= result.question.question_label %></h3>
            <dl>
              <dt>問題文</dt><dd><%= result.question.question_text %></dd>
              <dt>生徒解答（AI読み取り）</dt><dd><%= result.student_answer.presence || "読み取り結果なし（答案PDFを確認してください）" %></dd>
              <dt>正答</dt><dd><%= result.question.correct_answer %></dd>
              <% unless result.final_judgment == "correct" %>
              <dt>要確認理由</dt><dd><%= result.review_reason.presence || "—" %></dd>
              <dt>フィードバック</dt><dd><%= result.feedback.presence || "—" %></dd>
              <% end %>
              <dt>最終判定</dt><dd><%= result.final_judgment == "needs_review" ? "未確定（要確認）" : judgment_label(result.final_judgment) %></dd>
            </dl>
            <% unless guest_session? %>
            <%= label_tag "judgment_#{result.id}", "問題#{result.question.question_label}の最終判定" %>
            <%= hidden_field_tag "original_final_judgments[#{result.id}]", result.final_judgment %>
            <%= select_tag "final_judgments[#{result.id}]",
              options_for_select((result.final_judgment == "needs_review" ? [[ "未確定（要確認）", "" ]] : []) + [[ "正解", "correct" ], [ "不正解", "incorrect" ]], result.final_judgment == "needs_review" ? "" : result.final_judgment),
              id: "judgment_#{result.id}" %>
            <% end %>
          </article>
        <% end %>
        <%= submit_tag "保存" unless guest_session? %>
      <% end %>
    <% end %>
    <% end %>
  </section>
</div>
