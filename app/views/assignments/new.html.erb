<h1>小テスト配信</h1>

<%= link_to "配信済み小テスト", assignments_path %>

<% if flash[:notice].present? %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>

<% if @assignment.errors.any? %>
  <div role="alert">
    <ul>
      <% @assignment.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @assignment do |form| %>
  <div>
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :point_per_question, "1問あたりの点数" %>
    <%= form.number_field :point_per_question, min: 1, step: 1 %>
  </div>
  <div>
    <%= form.label :material_file, "教材ファイル（必須）" %>
    <%= form.file_field :material_file %>
  </div>
  <p>入力エラーが表示された場合は、教材ファイルを再選択してください。</p>
  <fieldset>
    <legend>配信先クラス（最低1クラスを選択）</legend>
    <%= hidden_field_tag "assignment[classroom_ids][]", "" %>
    <% if @classrooms.empty? %>
      <p>配信できるクラスがありません。</p>
    <% end %>
    <% @classrooms.each do |classroom| %>
      <div>
        <%= check_box_tag "assignment[classroom_ids][]", classroom.id,
          @selected_classroom_ids.include?(classroom.id), id: "classroom_#{classroom.id}" %>
        <%= label_tag "classroom_#{classroom.id}", "#{classroom.grade}年#{classroom.class_number}組" %>
      </div>
    <% end %>
  </fieldset>
  <%= form.submit "配信" %>
<% end %>
