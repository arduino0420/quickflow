<% content_for :title, "小テスト詳細・採点結果 | QuickFlow" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<h1><%= @assignment.title %><%= "の採点結果" if @submission.persisted? %></h1>

<%= link_to "一覧へ戻る", student_assignments_path %>

<% unless @submission.persisted? %>
  <dl class="assignment-metadata">
    <dt>タイトル</dt>
    <dd><%= @assignment.title %></dd>
    <dt>1問あたりの点数</dt>
    <dd><%= @assignment.point_per_question %></dd>
    <dt>教材ファイル名</dt>
    <dd><%= @assignment.material_file.filename if @assignment.material_file.attached? %></dd>
  </dl>

  <% if @assignment.material_file.attached? %>
    <%= link_to "教材をダウンロード", material_student_assignment_path(@assignment, download: "1"), data: { turbo: false } %>
  <% end %>
<% end %>

<% if flash[:notice].present? %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert].present? %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<% if @submission.persisted? %>
  <div class="teacher-review-layout">
    <section aria-label="提出した答案PDF">
      <% if @submission.answer_file.attached? %>
        <% if @submission.answer_file.content_type == "application/pdf" %>
          <%= render "shared/answer_pdf", url: answer_student_assignment_path(@assignment), title: "提出した答案PDF" %>
        <% else %>
          <p>答案ファイルをPDFとして表示できません。先生に確認してください。</p>
        <% end %>
      <% else %>
        <p>答案PDFが添付されていません。先生に確認してください。</p>
      <% end %>
    </section>
    <section aria-label="採点結果" class="student-grading-panel"
      data-controller="grading-presentation"
      data-action="turbo:before-frame-render->grading-presentation#beforeRender turbo:frame-load->grading-presentation#frameLoaded turbo:before-fetch-response->grading-presentation#responseReceived turbo:fetch-request-error->grading-presentation#requestFailed turbo:frame-missing->grading-presentation#requestFailed">
      <%= render "grading_status" %>
    </section>
  </div>
<% elsif !guest_session? %>
  <% if @assignment.material_file.attached? %>
    <%= link_to "PDFに解答する", student_assignment_pdf_preview_path(@assignment) %>
  <% end %>
  <details <%= "open" if @submission.errors.any? %>>
    <summary>従来のPDFアップロード</summary>
    <h2>解答PDFの提出</h2>
    <% if @submission.errors.any? %>
      <div role="alert">
        <ul>
          <% @submission.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= form_with model: @submission, url: student_assignment_submission_path(@assignment),
      data: { controller: "submission-confirmation", submission_confirmation_context_value: AnswerDraftContext.issue(current_student, @assignment),
        submission_confirmation_state_url_value: student_assignment_path(@assignment),
        action: "submit->submission-confirmation#request turbo:submit-end->submission-confirmation#submitted turbo:before-cache@document->submission-confirmation#disconnect pagehide@window->submission-confirmation#cancel" } do |form| %>
      <%= form.label :answer_file, "解答PDF" %>
      <%= form.file_field :answer_file, accept: "application/pdf,.pdf", data: { submission_confirmation_target: "file" } %>
      <%= form.submit "提出", disabled: true, data: { submission_confirmation_target: "submit" } %>
      <p role="alert" data-submission-confirmation-target="status"></p>
      <noscript><p>提出の確認にはJavaScriptが必要です。設定を確認してください。</p></noscript>
    <% end %>
  </details>
<% end %>
