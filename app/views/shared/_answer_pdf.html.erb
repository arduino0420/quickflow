<div class="answer-pdf" data-controller="answer-pdf"
  data-answer-pdf-url-value="<%= url %>"
  data-answer-pdf-assets-url-value="<%= request.script_name %>/vendor/pdfjs/6.4.299/">
  <p role="status" aria-live="polite" data-answer-pdf-target="status">答案PDFを読み込んでいます。</p>
  <div data-answer-pdf-target="pagination" hidden>
    <label>表示ページ
      <select data-answer-pdf-target="page" data-action="change->answer-pdf#changePage" disabled></select>
    </label>
  </div>
  <div class="answer-pdf__pages" data-answer-pdf-target="pages" aria-label="<%= title %>"></div>
  <p><%= link_to "PDFを別タブで開く", url, target: "_blank", rel: "noopener" %></p>
</div>
