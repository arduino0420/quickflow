<div class="guest-answer-pdf" data-controller="guest-pdf"
  data-guest-pdf-url-value="<%= url %>"
  data-guest-pdf-assets-url-value="<%= request.script_name %>/vendor/pdfjs/6.4.299/">
  <p role="status" aria-live="polite" data-guest-pdf-target="status">答案PDFを読み込んでいます。</p>
  <div class="guest-answer-pdf__pages" data-guest-pdf-target="pages" aria-label="<%= title %>"></div>
  <p><%= link_to "PDFを別タブで開く", url, target: "_blank", rel: "noopener" %></p>
</div>
